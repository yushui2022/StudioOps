{
  "name": "studioops",
  "version": "0.1.7",
  "private": true,
  "description": "Desktop-first local operations console for macOS development and AI services",
  "type": "module",
  "scripts": {
    "dev": "tsx watch services/agent/src/index.ts",
    "start": "tsx services/agent/src/index.ts",
    "build:agent": "esbuild services/agent/src/index.ts --bundle --platform=node --format=cjs --outfile=dist/agent.cjs --external:node:*",
    "build:gateway": "esbuild services/gateway/src/index.ts --bundle --platform=node --format=cjs --outfile=dist/gateway.cjs --external:node:*",
    "build:services": "npm run build:agent && npm run build:gateway",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.3",
    "hono": "^4.9.8",
    "ws": "^8.18.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
