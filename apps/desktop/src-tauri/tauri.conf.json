{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioOps",
  "version": "0.1.3",
  "identifier": "com.studioops.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run start",
    "beforeBuildCommand": "npm --prefix ../.. run build:agent",
    "devUrl": "http://127.0.0.1:7227",
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "StudioOps",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7227 ws://127.0.0.1:7227; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/app-icon.icns", "icons/app-icon.png"],
    "macOS": {
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    },
    "resources": {
      "../../../dist/agent.cjs": "agent.cjs",
      "../../web": "web"
    }
  }
}
